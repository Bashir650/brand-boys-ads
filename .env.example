# --- Meta (Facebook) App credentials ---
# Create at https://developers.facebook.com -> My Apps -> Create App -> "Business"
META_APP_ID=
META_APP_SECRET=

# Long-lived access token with ads_read (and ads_management if you want to pull
# your own account insights). Generate via the dashboard's "Connect Meta" page,
# or manually via Graph API Explorer + scripts/exchange_token.py
META_ACCESS_TOKEN=

# Your own Meta Ads account, format: act_1234567890
META_AD_ACCOUNT_ID=

# Graph API version to target (bump as Meta deprecates old versions)
META_GRAPH_API_VERSION=v19.0

# OAuth redirect URI registered in the Meta App's "Valid OAuth Redirect URIs"
META_OAUTH_REDIRECT_URI=http://localhost:8501/Connect_Meta

# Countries to search in the Ad Library, comma-separated ISO codes
AD_LIBRARY_COUNTRIES=IN,US

# Feature flags for the best-effort / unofficial collectors
ENABLE_TIKTOK_COLLECTOR=true
ENABLE_GOOGLE_TRANSPARENCY_COLLECTOR=false

# Database (defaults to a local SQLite file; swap for Postgres/Supabase for
# multi-user / production use, e.g. postgresql+psycopg2://user:pass@host/db)
DATABASE_URL=sqlite:///data/ads.db
